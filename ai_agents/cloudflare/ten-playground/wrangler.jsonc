{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "ten-playground",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-08",
  "observability": {
    "enabled": true,
  },
  "containers": [
    {
      "class_name": "TenPlayground",
      "image": "./Dockerfile",
      "image_build_context": "../..",
      "instance_type": "standard-3",
      "max_instances": 1,
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "TEN_PLAYGROUND",
        "class_name": "TenPlayground",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["TenPlayground"],
    },
  ],
}
