{
  "ten": {
    "predefined_graphs": [
      {
        "name": "va_in_meesho_stack",
        "auto_start": false,
        "graph": {
          "nodes": [
            {
              "type": "extension",
              "name": "stt",
              "addon": "deepgram_asr_python",
              "extension_group": "stt",
              "property": {
                "params": {
                  "api_key": "${env:DEEPGRAM_API_KEY}",
                  "model": "nova-3",
                  "language": "multi",
                  "sample_rate": 8000
                }
              }
            },
            {
              "type": "extension",
              "name": "llm",
              "addon": "openai_llm2_python",
              "extension_group": "chatgpt",
              "property": {
                "max_memory_length": 10,
                "base_url": "https://api.openai.com/v1",
                "api_key": "${env:OPENAI_API_KEY}",
                "frequency_penalty": 0.9,
                "model": "${env:OPENAI_MODEL|gpt-4o-mini}",
                "max_tokens": 512,
                "prompt": "You are Maya, the customer support voice agent for SuperYou (superyou.in), an Indian protein-snacks brand. You handle: order status ('where is my order'), delivery issues, missing/wrong/damaged items, and product or policy questions. TOOLS - always use them, never guess: get_order_status for any order/delivery question (the caller's phone number is in context - use it without asking; only ask for the order number if the phone lookup finds nothing). search_superyou_kb before answering ANY question about products, prices, flavours, nutrition, allergens, shipping, returns or payments. recall_customer_memory when the caller references a previous call, order or complaint ('my last order', 'the issue I reported') or when their history matters. transfer_to_human when the caller asks for a human, is angry, or has a claim you cannot resolve - first tell them you are transferring, then call the tool and relay its message. For wrong/missing item complaints: apologize, confirm the order via get_order_status, tell them a replacement claim is being registered, then transfer_to_human with the details. MEMORY: known facts about this caller from previous calls may appear in context with dates. Use them naturally to personalize ('aapka pichla issue resolve ho gaya tha?') - prefer recent facts over old ones, and never recite the list. LANGUAGE: mirror the caller exactly - Hindi, English or Hinglish. STYLE: this is a phone call - warm, short answers, one or two sentences, no lists, no emojis. Say numbers naturally. When reading tracking updates, summarise: courier name, current status and expected delivery date.",
                "proxy_url": "${env:OPENAI_PROXY_URL|}",
                "greeting": "Namaste! Welcome to SuperYou support. Aap Hindi ya English mein baat kar sakte hain. How can I help you today?"
              }
            },
            {
              "type": "extension",
              "name": "tts",
              "addon": "elevenlabs_tts2_python",
              "extension_group": "tts",
              "property": {
                "params": {
                  "key": "${env:ELEVENLABS_TTS_KEY}",
                  "model_id": "eleven_flash_v2_5",
                  "voice_id": "${env:ELEVENLABS_VOICE_ID|pNInz6obpgDQGcFmaJgB}",
                  "output_format": "pcm_16000"
                },
                "dump_path": "./",
                "dump": false
              }
            },
            {
              "type": "extension",
              "name": "main_control",
              "addon": "main_python",
              "extension_group": "control",
              "property": {
                "greeting": "Namaste! Welcome to SuperYou support. Aap Hindi ya English mein baat kar sakte hain. How can I help you today?",
                "plivo_auth_id": "${env:PLIVO_AUTH_ID}",
                "plivo_auth_token": "${env:PLIVO_AUTH_TOKEN}",
                "plivo_from_number": "${env:PLIVO_FROM_NUMBER}",
                "plivo_server_port": 9000,
                "plivo_public_server_url": "${env:PLIVO_PUBLIC_SERVER_URL}",
                "plivo_use_https": true,
                "plivo_use_wss": true,
                "demo_api_base": "${env:DEMO_API_BASE|}",
                "mem0_api_key": "${env:MEM0_API_KEY|}",
                "human_agent_number": "${env:HUMAN_AGENT_NUMBER|}"
              }
            },
            {
              "type": "extension",
              "name": "message_collector",
              "addon": "message_collector2",
              "extension_group": "transcriber",
              "property": {}
            },
            {
              "type": "extension",
              "name": "streamid_adapter",
              "addon": "streamid_adapter",
              "property": {}
            },
            {
              "type": "extension",
              "name": "superyou_tools",
              "addon": "superyou_tools_python",
              "extension_group": "default",
              "property": {
                "demo_api_base": "${env:DEMO_API_BASE|}",
                "plivo_server_port": 9000
              }
            }
          ],
          "connections": [
            {
              "extension": "streamid_adapter",
              "audio_frame": [
                {
                  "name": "pcm_frame",
                  "dest": [
                    {
                      "extension": "stt"
                    }
                  ]
                }
              ]
            },
            {
              "extension": "stt",
              "data": [
                {
                  "name": "asr_result",
                  "dest": [
                    {
                      "extension": "main_control"
                    }
                  ]
                }
              ]
            },
            {
              "extension": "main_control",
              "audio_frame": [
                {
                  "name": "pcm_frame",
                  "dest": [
                    {
                      "extension": "streamid_adapter"
                    }
                  ]
                }
              ]
            },
            {
              "extension": "tts",
              "audio_frame": [
                {
                  "name": "pcm_frame",
                  "dest": [
                    {
                      "extension": "main_control"
                    }
                  ]
                }
              ]
            },
            {
              "extension": "main_control",
              "cmd": [
                {
                  "names": ["tool_register"],
                  "source": [
                    {
                      "extension": "superyou_tools"
                    }
                  ]
                }
              ]
            }
          ]
        }
